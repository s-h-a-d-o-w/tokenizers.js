{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "lib": ["DOM", "es2022"],
    "jsx": "react-jsx",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "declaration": true,
    "declarationDir": "types",
    "outDir": "types",
    "strict": true,
    "sourceMap": true,
    "strictNullChecks": false,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "tests/**/*"]
}
